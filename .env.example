# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# The discovery loop talks to ONE provider-agnostic adapter, so switching
# providers is a base URL and a model name — nothing else changes.
# Replay never reads any of this: it makes zero model calls by construction.

# Which adapter to use: zai | gemini | anthropic | cassette
MODEL_PROVIDER=zai

# Your API key. Free from https://z.ai (no credit card).
MODEL_API_KEY=

# OpenAI-compatible endpoint for the chosen provider.
#   Z.ai     https://api.z.ai/api/paas/v4
#   Gemini   https://generativelanguage.googleapis.com/v1beta/openai
MODEL_BASE_URL=https://api.z.ai/api/paas/v4

# Model id.
#   Z.ai     glm-4.7-flash
#   Gemini   gemini-3.6-flash
MODEL_NAME=glm-4.7-flash

# Target app (the local mock). No credentials leave your machine.
MOCK_TENANT_A_URL=http://localhost:7101
MOCK_TENANT_B_URL=http://localhost:7102
