{
 "schemaVersion": 1,
 "contract": {
  "id": "msc.card.report_lost",
  "version": "1.0.0",
  "goal": "Report a member's debit card lost or stolen and return the confirmation number.",
  "purpose": "The same five screens as msc.card.set_status, with one difference that changes everything about how it runs: the status it sets cannot be undone from this product, so the step that commits it is irreversible and no artifact may take it unattended.",
  "inputs": [
   {
    "name": "member_id",
    "type": "string",
    "pattern": "^\\d{9}$",
    "required": true,
    "sensitivity": "confidential",
    "description": "Member account base number."
   },
   {
    "name": "card_last4",
    "type": "string",
    "pattern": "^\\d{4}$",
    "required": true,
    "sensitivity": "confidential",
    "description": "Last four of the card to report. Last four rather than the PAN: it is what the app's own selector takes, and it is the most that may cross this boundary."
   }
  ],
  "outputs": [
   {
    "name": "confirmation_number",
    "type": "string",
    "sensitivity": "confidential",
    "producedBy": "s08",
    "description": "The app's own reference for the change, read after a person has completed the step the policy refused."
   }
  ],
  "outcomes": [
   {
    "code": "MEMBER_NOT_FOUND",
    "message": "No member matches that id.",
    "when": {
     "all": [
      {
       "atom": "screen",
       "is": "MEMBER_RESULTS"
      },
      {
       "atom": "text",
       "contains": "MSG 0071"
      }
     ],
     "any": []
    },
    "source": "app_profile",
    "note": "Detected at s02, long before the irreversible step. A legitimate answer, not a failure."
   },
   {
    "code": "CARD_NOT_FOUND",
    "message": "That member holds no card with those last four.",
    "when": {
     "all": [
      {
       "atom": "screen",
       "is": "CARD_SERVICES"
      },
      {
       "atom": "text",
       "contains": "MSG 0114"
      }
     ],
     "any": []
    },
    "source": "app_profile",
    "note": "The app refuses and stays on CRD0500. Nothing was changed."
   },
   {
    "code": "CARD_ALREADY_IN_STATE",
    "message": "That card is already reported lost or stolen.",
    "when": {
     "all": [
      {
       "atom": "screen",
       "is": "CARD_SERVICES"
      },
      {
       "atom": "text",
       "contains": "MSG 0121"
      }
     ],
     "any": []
    },
    "source": "app_profile",
    "note": "Already lost/stolen is the world already being as asked. Filing it as a failure would make a duplicate report look like a broken system."
   }
  ],
  "risk": "irreversible",
  "requiresSession": true
 },
 "plan": {
  "app": "MERIDIAN MSC",
  "targets": [
   {
    "id": "MEMBER_ID",
    "screen": "MEMBER_SEARCH",
    "framePath": [
     {
      "name": "content",
      "urlPattern": "/screen/search$"
     }
    ],
    "strategies": [
     {
      "kind": "table_anchor",
      "key": "MEMBER_ID",
      "matchedAtRecord": 1
     },
     {
      "kind": "field_key",
      "key": "MEMBER_ID",
      "matchedAtRecord": 1
     }
    ],
    "verify": {
     "role": "textbox"
    },
    "nameMayContainPii": false,
    "robustness": "Anchored on the visible label cell rather than position: measured to survive both a frame rename and a field rename. The nav frame carries a control with the SAME field name, so the frame hop is load-bearing."
   },
   {
    "id": "SUBMIT",
    "screen": "MEMBER_SEARCH",
    "framePath": [
     {
      "name": "content",
      "urlPattern": "/screen/search$"
     }
