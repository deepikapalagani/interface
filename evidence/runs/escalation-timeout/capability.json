    },
    "nameMayContainPii": false,
    "robustness": "Anchored on its label cell; its row holds exactly one control. The url pattern is the prefix /screen/card rather than the entry route, because the same screen is re-rendered from the action route after a refusal."
   },
   {
    "id": "CARD_ACTION",
    "screen": "CARD_SERVICES",
