    },
    "nameMayContainPii": false,
    "robustness": "A labelled row whose single control is the link into card services. The nav frame renders the same words, which is why the target is frame-scoped to content."
   },
   {
    "id": "CARD_SELECT",
    "screen": "CARD_SERVICES",
    "framePath": [
     {
