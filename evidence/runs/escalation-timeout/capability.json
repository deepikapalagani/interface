     }
    ],
    "strategies": [
     {
      "kind": "field_key",
      "key": "CARD_APPLY",
      "matchedAtRecord": 1
     }
    ],
    "verify": {},
    "nameMayContainPii": false,
    "robustness": "The control that commits the irreversible change. Like every submit on this surface it is an image input with an empty alt and no label cell in its row, so the app's own control name is the only handle."
   },
   {
    "id": "CONFIRMATION_NUMBER",
    "screen": "CONFIRMATION",
    "framePath": [
     {
      "name": "content",
      "urlPattern": "/screen/card-action$"
     }
    ],
    "strategies": [
     {
      "kind": "table_anchor",
      "key": "CONFIRMATION",
      "matchedAtRecord": 1
     }
    ],
    "verify": {},
    "nameMayContainPii": false,
    "robustness": "Static text, read by anchoring the row on its label cell and taking the NEXT cell, never by column index. Exactly one row on the confirmation screen carries that label."
   }
  ],
  "steps": [
   {
    "ref": "s01",
    "title": "Enter the member id",
    "action": "fill",
    "target": "MEMBER_ID",
    "value": "{{member_id}}",
    "pre": {
     "all": [
      {
       "atom": "screen",
       "is": "MEMBER_SEARCH"
