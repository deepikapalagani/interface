    "strategies": [
     {
      "kind": "field_key",
      "key": "SUBMIT",
      "matchedAtRecord": 1
     }
    ],
    "verify": {},
    "nameMayContainPii": false,
    "robustness": "An image submit with an empty alt has no accessible name at all, so the app's own control name is the only stable handle this surface offers."
   },
   {
    "id": "OPEN_MEMBER",
    "screen": "MEMBER_RESULTS",
    "framePath": [
     {
      "name": "content",
      "urlPattern": "/screen/results"
     }
    ],
    "strategies": [
     {
      "kind": "table_anchor",
      "key": "OPEN_MEMBER",
      "matchedAtRecord": 1
     }
    ],
    "verify": {
     "role": "link"
    },
    "nameMayContainPii": false,
    "robustness": "The only durable handle on a result row is the link in its own trailing ACTION cell; the header cell reads ACTION rather than the link text, so the header row cannot match. Two matches make the resolver refuse instead of guessing, which is the right answer when a plan cannot say which member it meant."
   },
   {
    "id": "CARD_SERVICES_LINK",
    "screen": "MEMBER_DETAIL",
    "framePath": [
     {
      "name": "content",
