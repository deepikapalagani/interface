       "is": "MEMBER_RESULTS"
      },
      {
       "atom": "text",
       "contains": "MSG 0071"
      }
     ],
     "any": []
    },
    "source": "app_profile",
    "note": "The app's own message for an empty result set. A legitimate answer the caller asked for, not a failure."
   }
  ],
  "risk": "read_only",
  "requiresSession": false
 },
 "plan": {
  "app": "MERIDIAN MSC",
  "targets": [
