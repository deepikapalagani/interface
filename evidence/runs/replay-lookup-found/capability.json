    "screen": "MEMBER_SEARCH",
    "framePath": [
     {
      "name": "content",
      "urlPattern": "/screen/search$"
     }
    ],
    "strategies": [
     {
      "kind": "table_anchor",
      "key": "MEMBER_ID",
      "matchedAtRecord": 1
     },
     {
      "kind": "field_key",
      "key": "MEMBER_ID",
      "matchedAtRecord": 1
     }
    ],
    "verify": {
