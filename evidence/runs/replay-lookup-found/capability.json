{
 "schemaVersion": 1,
 "contract": {
  "id": "msc.member.lookup",
  "version": "1.0.0",
  "goal": "Look up a member by id and reach the results screen.",
  "purpose": "The thinnest read-only flow on this surface: proves frame traversal, structural anchoring, and the business-outcome path without changing anything.",
  "inputs": [
